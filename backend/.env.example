# ==========================================
# BACKEND - variaveis de ambiente
# Copie para .env e ajuste os valores
# cp .env.example .env
# ==========================================

NODE_ENV=production
PORT=8080
PROXY_PORT=443

BACKEND_URL=https://api.seudominio.com.br
FRONTEND_URL=https://seudominio.com.br

# ---------- Banco de dados (Postgres) ----------
DB_HOST=localhost
DB_PORT=5432
DB_DIALECT=postgres
DB_NAME=SUA_BASE
DB_USER=SEU_USUARIO
DB_PASS=SUA_SENHA
DB_POOL_MAX=100
DB_POOL_MIN=15
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=600000

# ---------- Autenticacao ----------
# IMPORTANTE: o frontend envia o token fixo "wtV" em /public-settings
# (hooks/useSettings/index.js). Se este valor for alterado aqui,
# o mesmo valor precisa ser alterado no frontend, senao cores,
# logos e nome do sistema vao retornar 403.
ENV_TOKEN=wtV

# Gere com: openssl rand -base64 32
MASTER_KEY=
JWT_SECRET=
JWT_REFRESH_SECRET=

# ---------- Redis / filas ----------
# REDIS_URI_ACK: usada por libs/queue.ts (BullBoard) e pelo guard em server.ts
REDIS_URI=redis://:SENHAREDIS@127.0.0.1:6379
REDIS_URI_ACK=redis://:SENHAREDIS@127.0.0.1:6379
REDIS_OPT_LIMITER_MAX=1
REDIS_OPT_LIMITER_DURATION=3000

# ---------- Limites ----------
USER_LIMIT=1
CONNECTIONS_LIMIT=1
CLOSED_SEND_BY_ME=true

# ---------- Tokens de integracao ----------
VERIFY_TOKEN=whaticket
COMPANY_TOKEN=whaticket

TIMEOUT_TO_IMPORT_MESSAGE=1000

# ---------- E-mail (recuperacao de senha) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=seuemail@gmail.com
SMTP_PASS=senhaDeApp
SMTP_FROM="Seu Nome <seuemail@gmail.com>"

# ---------- Mercado Pago ----------
MP_ACCESS_TOKEN=

# ---------- Opcional ----------
SENTRY_DSN=
BULL_BOARD=false
BULL_USER=
BULL_PASS=
